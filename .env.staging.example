NODE_ENV=production
DEPLOYMENT_ENV=staging
DATABASE_URL=postgresql://STAGING_APP_USER:REPLACE_ME@STAGING_DB_HOST:5432/dynicty_automotive_staging?schema=public
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_48_PLUS_CHARACTER_STAGING_SECRET
NEXT_PUBLIC_SITE_URL=https://automotive-preview.dynicty.com
TRUST_PROXY=true

# Choose one isolated staging storage strategy.
STORAGE_PROVIDER=local
ALLOW_STAGING_LOCAL_STORAGE=true

# Required only when STORAGE_PROVIDER=r2; use a staging-only bucket/prefix and key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dynicty-automotive-staging
R2_PUBLIC_URL=https://REPLACE_WITH_STAGING_MEDIA_HOST

# Temporary operator inputs for `pnpm db:seed:staging`; do not persist after seeding.
STAGING_ADMIN_EMAIL=admin-staging@example.invalid
STAGING_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_STAGING_ONLY_PASSWORD
