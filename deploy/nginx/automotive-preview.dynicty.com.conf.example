map $http_upgrade $automotive_preview_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name automotive-preview.dynicty.com;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name automotive-preview.dynicty.com;

    ssl_certificate /REPLACE_WITH_CERTIFICATE_PATH/fullchain.pem;
    ssl_certificate_key /REPLACE_WITH_CERTIFICATE_PATH/privkey.pem;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $automotive_preview_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
