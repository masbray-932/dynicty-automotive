# Install once per dedicated listener, not once per customer.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 421;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
    return 421;
}
