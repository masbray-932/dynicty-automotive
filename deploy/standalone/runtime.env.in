# Copy outside Git as @CONFIG@/runtime.env (root:root 0600). Replace placeholders.
NODE_ENV=production
DEPLOYMENT_ENV=production
NEXT_PUBLIC_SITE_URL=https://@HOST@
DATABASE_URL=postgresql://@DB@:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/@DB@?schema=public
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
STORAGE_PROVIDER=local
ALLOW_STANDALONE_LOCAL_STORAGE=true
TRUST_PROXY=true
# Admin bootstrap credentials are one-shot operator inputs, never runtime settings.
