# Required server-only configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dynicty_automotive?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Optional public canonical base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storage foundation (local is intended for development only)
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Used only by `pnpm db:seed`; never commit real values
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
