# Required server-only configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dynicty_automotive?schema=public"
SESSION_SECRET="development-only-replace-with-48-plus-random-characters"

# Required HTTPS canonical base URL in production
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storage foundation: production local storage requires the standalone opt-in and isolated volume.
STORAGE_PROVIDER="local"
ALLOW_STANDALONE_LOCAL_STORAGE="false"
# Set true only when the app port is private and Nginx overwrites X-Real-IP/X-Forwarded-For.
TRUST_PROXY="false"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Used only by `pnpm db:seed`; never commit real values
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
