generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CarCondition {
  NEW
  USED
}

enum CarStatus {
  DRAFT
  AVAILABLE
  SOLD
}

enum InventoryMode {
  BOTH
  USED_ONLY
  NEW_ONLY
}

model AdminUser {
  id                  String                  @id @default(cuid())
  name                String                  @default("")
  email               String                  @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  platformRole        PlatformAdminRole?
  lastLoginAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            AdminSession[]
  memberships         AdminDealerMembership[]
  createdInvitations  AdminInvitation[]       @relation("InvitationCreator")
  acceptedInvitations AdminInvitation[]       @relation("InvitationAcceptor")
  emailChangeTokens   AdminEmailChangeToken[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

enum PlatformAdminRole {
  OWNER
  SUPPORT
}

enum DealerAdminRole {
  OWNER
  ADMIN
}

enum DealerMembershipStatus {
  ACTIVE
  REVOKED
}

model AdminDealerMembership {
  id               String                 @id @default(cuid())
  adminId          String
  dealerSettingsId String
  role             DealerAdminRole        @default(ADMIN)
  status           DealerMembershipStatus @default(ACTIVE)
  activatedAt      DateTime               @default(now())
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  admin            AdminUser              @relation(fields: [adminId], references: [id], onDelete: Cascade)
  dealerSettings   DealerSettings         @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([adminId, dealerSettingsId])
  @@index([dealerSettingsId, status, role])
}

model AdminInvitation {
  id               String          @id @default(cuid())
  dealerSettingsId String
  invitedEmail     String
  role             DealerAdminRole @default(OWNER)
  tokenHash        String          @unique @db.VarChar(64)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdById      String
  acceptedById     String?
  createdAt        DateTime        @default(now())
  dealerSettings   DealerSettings  @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy        AdminUser       @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy       AdminUser?      @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([dealerSettingsId, invitedEmail, expiresAt])
}

model AdminEmailChangeToken {
  id        String    @id @default(cuid())
  adminId   String
  newEmail  String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model AdminAuditLog {
  id               String   @id @default(cuid())
  dealerSettingsId String?
  actorAdminId     String?
  targetAdminId    String?
  action           String   @db.VarChar(80)
  detail           String   @default("") @db.VarChar(500)
  createdAt        DateTime @default(now())

  @@index([dealerSettingsId, createdAt])
  @@index([actorAdminId, createdAt])
}

model Brand {
  id             String     @id @default(cuid())
  name           String     @unique
  slug           String     @unique
  logoStorageKey String?
  active         Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  models         CarModel[]
  cars           Car[]
  dealerId       String?
  dealer         Dealer?    @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedModels    CarModel[] @relation("OwnedBrandModels")

  @@unique([dealerId, id])
  @@index([dealerId, active, sortOrder])
}

model CarModel {
  id         String   @id @default(cuid())
  brandId    String
  name       String
  slug       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  cars       Car[]
  dealerId   String?
  dealer     Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedBrand Brand?   @relation("OwnedBrandModels", fields: [dealerId, brandId], references: [dealerId, id], onDelete: Restrict, onUpdate: Restrict)
  ownedCars  Car[]    @relation("OwnedModelCars")

  @@unique([dealerId, id])
  @@unique([dealerId, brandId, id])
  @@unique([brandId, slug])
  @@index([brandId])
}

model Car {
  id           String       @id @default(cuid())
  slug         String       @unique
  condition    CarCondition
  brandId      String
  modelId      String
  variant      String
  year         Int
  price        Decimal      @db.Decimal(15, 0)
  transmission String
  fuelType     String
  color        String
  mileage      Int?
  description  String       @db.Text
  status       CarStatus    @default(DRAFT)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model        CarModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  images       CarImage[]
  dealerId     String?
  dealer       Dealer?      @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedModel   CarModel?    @relation("OwnedModelCars", fields: [dealerId, brandId, modelId], references: [dealerId, brandId, id], onDelete: Restrict, onUpdate: Restrict)
  ownedImages  CarImage[]   @relation("OwnedCarImages")

  @@unique([dealerId, id])
  @@index([dealerId, brandId, modelId])
  @@index([condition, status])
  @@index([status, updatedAt])
  @@index([brandId, modelId])
  @@index([featured, status])
  @@index([year])
  @@index([price])
}

model CarImage {
  id         String   @id @default(cuid())
  carId      String
  storageKey String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  dealerId   String?
  dealer     Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedCar   Car?     @relation("OwnedCarImages", fields: [dealerId, carId], references: [dealerId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([dealerId, id])
  @@unique([carId, storageKey])
  @@index([dealerId, carId])
  @@index([carId, sortOrder])
  @@index([carId, isPrimary])
}

enum DealerLifecycle {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DealerDomainVerificationState {
  PENDING
  VERIFIED
  REVOKED
}

enum DealerDomainRoutingState {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
}

model Dealer {
  id          String          @id @default(cuid())
  slug        String          @unique
  displayName String
  lifecycle   DealerLifecycle @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  domains     DealerDomain[]
  settings    DealerSettings?
  brands      Brand[]
  carModels   CarModel[]
  cars        Car[]
  carImages   CarImage[]
}

model DealerDomain {
  id                String                        @id @default(cuid())
  dealerId          String
  hostname          String                        @unique @db.VarChar(253)
  verificationState DealerDomainVerificationState @default(PENDING)
  routingState      DealerDomainRoutingState      @default(PENDING)
  isCanonical       Boolean                       @default(false)
  bindingVersion    Int                           @default(1)
  verifiedAt        DateTime?
  activatedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  dealer            Dealer                        @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dealerId, id])
  @@index([dealerId, routingState])
}

model DealerSettings {
  id                    String                  @id @default("default")
  dealerName            String                  @default("Dynicty Automotive")
  logoStorageKey        String?
  faviconStorageKey     String?
  whatsappNumber        String?
  whatsappWidgetEnabled Boolean                 @default(true)
  whatsappWidgetMessage String                  @default("") @db.VarChar(500)
  phone                 String?
  email                 String?
  address               String?
  googleMapsUrl         String?
  instagramUrl          String?
  facebookUrl           String?
  primaryColor          String?
  secondaryColor        String?
  inventoryMode         InventoryMode           @default(BOTH)
  inventoryUpdatedAt    DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  dealerId              String?                 @unique
  dealer                Dealer?                 @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  content               DealerContent?
  contentItems          DealerContentItem[]
  serviceCategories     ServiceCategory[]
  showroomServices      ShowroomService[]
  articles              Article[]
  salesTeam             SalesTeamMember[]
  serviceCtas           ServiceCtaConfig[]
  adminMemberships      AdminDealerMembership[]
  adminInvitations      AdminInvitation[]
}

model SalesTeamMember {
  id               String         @id @default(cuid())
  dealerSettingsId String
  fullName         String
  title            String
  imageStorageKey  String?
  whatsappNumber   String?
  biography        String         @default("") @db.Text
  active           Boolean        @default(false)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  dealerSettings   DealerSettings @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dealerSettingsId, id])
  @@index([dealerSettingsId, active, sortOrder])
}

enum DealerContentKind {
  MAIN_BANNER
  PROMO_BANNER
  ADVANTAGE
  FAQ
  LEASING_PARTNER
  TESTIMONIAL
}

model DealerContent {
  dealerId                String         @id
  welcomeTitle            String         @default("")
  welcomeBody             String         @default("") @db.Text
  welcomeActive           Boolean        @default(false)
  welcomeHeadingDesktopPx Int?
  welcomeHeadingMobilePx  Int?
  welcomeBodyDesktopPx    Int?
  welcomeBodyMobilePx     Int?
  aboutSummary            String         @default("") @db.Text
  aboutStory              String         @default("") @db.Text
  history                 String         @default("") @db.Text
  vision                  String         @default("") @db.Text
  mission                 String         @default("") @db.Text
  achievements            String         @default("") @db.Text
  aboutActive             Boolean        @default(false)
  showroomKey             String?
  showroomAlt             String         @default("")
  operatingHours          String         @default("") @db.Text
  operatingHoursActive    Boolean        @default(false)
  updatedAt               DateTime       @updatedAt
  dealer                  DealerSettings @relation(fields: [dealerId], references: [id], onDelete: Cascade)
}

model DealerContentItem {
  id        String            @id @default(cuid())
  dealerId  String
  kind      DealerContentKind
  title     String
  body      String            @default("") @db.Text
  link      String            @default("")
  mediaKey  String?
  active    Boolean           @default(false)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  dealer    DealerSettings    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, kind, active, sortOrder])
}

enum ContentPublicationStatus {
  DRAFT
  PUBLISHED
}

model ServiceCategory {
  id               String            @id @default(cuid())
  dealerSettingsId String
  name             String
  slug             String
  description      String            @default("") @db.Text
  sortOrder        Int               @default(0)
  active           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dealerSettings   DealerSettings    @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services         ShowroomService[]

  @@unique([dealerSettingsId, id])
  @@unique([dealerSettingsId, slug])
  @@index([dealerSettingsId, active, sortOrder])
}

model ShowroomService {
  id               String                   @id @default(cuid())
  dealerSettingsId String
  categoryId       String
  title            String
  slug             String
  shortDescription String                   @default("") @db.Text
  body             String                   @default("") @db.Text
  imageStorageKey  String?
  imageAlt         String                   @default("")
  status           ContentPublicationStatus @default(DRAFT)
  homepageVisible  Boolean                  @default(false)
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  dealerSettings   DealerSettings           @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category         ServiceCategory          @relation(fields: [dealerSettingsId, categoryId], references: [dealerSettingsId, id], onDelete: Restrict, onUpdate: Restrict)
  cta              ServiceCtaConfig?

  @@unique([dealerSettingsId, id])
  @@unique([dealerSettingsId, slug])
  @@index([dealerSettingsId, status, homepageVisible, sortOrder])
  @@index([dealerSettingsId, categoryId])
}

model ServiceCtaConfig {
  id                   String             @id @default(cuid())
  dealerSettingsId     String
  serviceId            String
  enabled              Boolean            @default(false)
  heading              String             @default("")
  description          String             @default("") @db.Text
  headingDesktopPx     Int                @default(40)
  descriptionDesktopPx Int                @default(18)
  headingMobilePx      Int                @default(28)
  descriptionMobilePx  Int                @default(16)
  backgroundColor      String             @default("#C8102E") @db.VarChar(7)
  textColor            String             @default("#FFFFFF") @db.VarChar(7)
  imageStorageKey      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  dealerSettings       DealerSettings     @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  service              ShowroomService    @relation(fields: [dealerSettingsId, serviceId], references: [dealerSettingsId, id], onDelete: Cascade, onUpdate: Restrict)
  buttons              ServiceCtaButton[]

  @@unique([dealerSettingsId, id])
  @@unique([dealerSettingsId, serviceId])
  @@index([dealerSettingsId, enabled])
}

model ServiceCtaButton {
  id               String           @id @default(cuid())
  dealerSettingsId String
  serviceCtaId     String
  label            String
  whatsappNumber   String
  backgroundColor  String           @default("#111111") @db.VarChar(7)
  textColor        String           @default("#FFFFFF") @db.VarChar(7)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cta              ServiceCtaConfig @relation(fields: [dealerSettingsId, serviceCtaId], references: [dealerSettingsId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([dealerSettingsId, id])
  @@index([dealerSettingsId, serviceCtaId, sortOrder])
}

model Article {
  id               String                   @id @default(cuid())
  dealerSettingsId String
  title            String
  slug             String
  excerpt          String                   @default("") @db.Text
  body             String                   @default("") @db.Text
  imageStorageKey  String?
  imageAlt         String                   @default("")
  status           ContentPublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  dealerSettings   DealerSettings           @relation(fields: [dealerSettingsId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dealerSettingsId, slug])
  @@index([dealerSettingsId, status, publishedAt])
}
