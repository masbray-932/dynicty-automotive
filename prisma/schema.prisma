generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CarCondition {
  NEW
  USED
}

enum CarStatus {
  DRAFT
  AVAILABLE
  SOLD
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Brand {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  models      CarModel[]
  cars        Car[]
  dealerId    String?
  dealer      Dealer?    @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedModels CarModel[] @relation("OwnedBrandModels")

  @@unique([dealerId, id])
}

model CarModel {
  id         String   @id @default(cuid())
  brandId    String
  name       String
  slug       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  cars       Car[]
  dealerId   String?
  dealer     Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedBrand Brand?   @relation("OwnedBrandModels", fields: [dealerId, brandId], references: [dealerId, id], onDelete: Restrict, onUpdate: Restrict)
  ownedCars  Car[]    @relation("OwnedModelCars")

  @@unique([dealerId, id])
  @@unique([dealerId, brandId, id])
  @@unique([brandId, slug])
  @@index([brandId])
}

model Car {
  id           String       @id @default(cuid())
  slug         String       @unique
  condition    CarCondition
  brandId      String
  modelId      String
  variant      String
  year         Int
  price        Decimal      @db.Decimal(15, 0)
  transmission String
  fuelType     String
  color        String
  mileage      Int?
  description  String       @db.Text
  status       CarStatus    @default(DRAFT)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model        CarModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  images       CarImage[]
  dealerId     String?
  dealer       Dealer?      @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedModel   CarModel?    @relation("OwnedModelCars", fields: [dealerId, brandId, modelId], references: [dealerId, brandId, id], onDelete: Restrict, onUpdate: Restrict)
  ownedImages  CarImage[]   @relation("OwnedCarImages")

  @@unique([dealerId, id])
  @@index([dealerId, brandId, modelId])
  @@index([condition, status])
  @@index([status, updatedAt])
  @@index([brandId, modelId])
  @@index([featured, status])
  @@index([year])
  @@index([price])
}

model CarImage {
  id         String   @id @default(cuid())
  carId      String
  storageKey String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  dealerId   String?
  dealer     Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedCar   Car?     @relation("OwnedCarImages", fields: [dealerId, carId], references: [dealerId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([dealerId, id])
  @@unique([carId, storageKey])
  @@index([dealerId, carId])
  @@index([carId, sortOrder])
  @@index([carId, isPrimary])
}

enum DealerLifecycle {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DealerDomainVerificationState {
  PENDING
  VERIFIED
  REVOKED
}

enum DealerDomainRoutingState {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
}

model Dealer {
  id          String          @id @default(cuid())
  slug        String          @unique
  displayName String
  lifecycle   DealerLifecycle @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  domains     DealerDomain[]
  settings    DealerSettings?
  brands      Brand[]
  carModels   CarModel[]
  cars        Car[]
  carImages   CarImage[]
}

model DealerDomain {
  id                String                        @id @default(cuid())
  dealerId          String
  hostname          String                        @unique @db.VarChar(253)
  verificationState DealerDomainVerificationState @default(PENDING)
  routingState      DealerDomainRoutingState      @default(PENDING)
  isCanonical       Boolean                       @default(false)
  bindingVersion    Int                           @default(1)
  verifiedAt        DateTime?
  activatedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  dealer            Dealer                        @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dealerId, id])
  @@index([dealerId, routingState])
}

model DealerSettings {
  id             String              @id @default("default")
  dealerName     String              @default("Dynicty Automotive")
  logoStorageKey String?
  whatsappNumber String?
  phone          String?
  email          String?
  address        String?
  googleMapsUrl  String?
  instagramUrl   String?
  facebookUrl    String?
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  dealerId       String?             @unique
  dealer         Dealer?             @relation(fields: [dealerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  content        DealerContent?
  contentItems   DealerContentItem[]
}

enum DealerContentKind {
  MAIN_BANNER
  PROMO_BANNER
  ADVANTAGE
  FAQ
  LEASING_PARTNER
}

model DealerContent {
  dealerId             String         @id
  welcomeTitle         String         @default("")
  welcomeBody          String         @default("") @db.Text
  welcomeActive        Boolean        @default(false)
  aboutSummary         String         @default("") @db.Text
  aboutStory           String         @default("") @db.Text
  aboutActive          Boolean        @default(false)
  showroomKey          String?
  showroomAlt          String         @default("")
  operatingHours       String         @default("") @db.Text
  operatingHoursActive Boolean        @default(false)
  updatedAt            DateTime       @updatedAt
  dealer               DealerSettings @relation(fields: [dealerId], references: [id], onDelete: Cascade)
}

model DealerContentItem {
  id        String            @id @default(cuid())
  dealerId  String
  kind      DealerContentKind
  title     String
  body      String            @default("") @db.Text
  link      String            @default("")
  mediaKey  String?
  active    Boolean           @default(false)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  dealer    DealerSettings    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, kind, active, sortOrder])
}
